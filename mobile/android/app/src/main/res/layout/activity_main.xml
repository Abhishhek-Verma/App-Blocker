<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- ======================================================== -->
    <!-- 1. LOGIN / CREATE ACCOUNT SCREEN (Clean White + #53A7E1)  -->
    <!-- ======================================================== -->
    <ScrollView
        android:id="@+id/layout_login_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="#FFFFFF"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:paddingVertical="36dp">

            <!-- Official SchoolMini Logo -->
            <FrameLayout
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_logo_container"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_schoolmini_logo"
                    android:contentDescription="SchoolMini Logo"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <!-- Brand Heading: #53A7E1 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="School Mini"
                android:textColor="#53A7E1"
                android:textSize="32sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zero-Distraction Education Firewall"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="28dp" />

            <!-- Clean Auth Card Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Mode Switch Tabs: Log In vs Create Account -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:background="#F1F5F9"
                    android:padding="3dp"
                    android:layout_marginBottom="22dp">

                    <Button
                        android:id="@+id/btn_tab_mode_login"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_brand"
                        android:text="Log In"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_tab_mode_register"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:text="Create Account"
                        android:textColor="#64748B"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Full Name Field (Only shown when creating account) -->
                <LinearLayout
                    android:id="@+id/layout_register_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FULL NAME"
                        android:textColor="#53A7E1"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/et_register_name"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_input_light"
                        android:hint="e.g. Alex Johnson"
                        android:textColor="#0F172A"
                        android:textColorHint="#94A3B8"
                        android:paddingHorizontal="16dp"
                        android:textSize="15sp"
                        android:singleLine="true"
                        android:layout_marginBottom="16dp" />
                </LinearLayout>

                <!-- Email Address Field -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EMAIL ADDRESS"
                    android:textColor="#53A7E1"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/et_login_email"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_input_light"
                    android:hint="e.g. student@school.edu"
                    android:textColor="#0F172A"
                    android:textColorHint="#94A3B8"
                    android:inputType="textEmailAddress"
                    android:paddingHorizontal="16dp"
                    android:textSize="15sp"
                    android:singleLine="true"
                    android:layout_marginBottom="16dp" />

                <!-- Password Field -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PASSWORD"
                    android:textColor="#53A7E1"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/et_login_password"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_input_light"
                    android:hint="••••••••"
                    android:textColor="#0F172A"
                    android:textColorHint="#94A3B8"
                    android:inputType="textPassword"
                    android:paddingHorizontal="16dp"
                    android:textSize="15sp"
                    android:singleLine="true"
                    android:layout_marginBottom="22dp" />

                <!-- Login Button (Visible in Login Mode) -->
                <Button
                    android:id="@+id/btn_action_login"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_button_brand"
                    android:text="Log In"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Create Account Button (Visible in Register Mode) -->
                <Button
                    android:id="@+id/btn_action_register"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_button_brand"
                    android:text="Create Account"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- Switch Mode Text Helper -->
                <TextView
                    android:id="@+id/tv_switch_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Need an account? Tap Create Account"
                    android:textColor="#53A7E1"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="16dp"
                    android:padding="4dp" />

                <!-- Status Feedback -->
                <TextView
                    android:id="@+id/tv_login_feedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#EF4444"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:layout_marginTop="10dp"
                    android:visibility="gone" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Secured with JWT Token Authentication"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:layout_marginTop="24dp" />

        </LinearLayout>
    </ScrollView>


    <!-- ======================================================== -->
    <!-- 2. DUTY MODE AMOLED SCREEN (OnePlus / Samsung Style)     -->
    <!-- ======================================================== -->
    <LinearLayout
        android:id="@+id/layout_duty_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="36dp"
        android:visibility="gone">

        <!-- Top Navigation Bar: Lock Indicator & Exit Button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp">

            <TextView
                android:id="@+id/tv_duty_locked_indicator"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_pill_blocked"
                android:text="🔒 DUTY LOCK ACTIVE"
                android:textColor="#FCA5A5"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true" />

            <Button
                android:id="@+id/btn_duty_power_toggle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_button_orange"
                android:text="⚡ Exit Duty"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="14dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true" />
        </RelativeLayout>

        <!-- Big Minimal Digital Clock -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="48dp">

            <TextView
                android:id="@+id/tv_duty_clock_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="08:46"
                android:textColor="#FFFFFF"
                android:textSize="64sp"
                android:textStyle="bold"
                android:letterSpacing="-0.03" />

            <TextView
                android:id="@+id/tv_duty_clock_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mon, Oct 26"
                android:textColor="#9CA3AF"
                android:textSize="15sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DUTY MODE ACTIVE"
                android:textColor="#34D399"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- 6 App Grid: Phone, Messages, Chrome, Camera, AI, SchoolMini -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Row 1: Phone, Messages, Chrome -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="24dp">

                <!-- 1. Phone App -->
                <LinearLayout
                    android:id="@+id/btn_launch_phone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:background="@drawable/bg_power_circle"
                        android:text="📞"
                        android:textSize="28sp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Phone"
                        android:textColor="#E5E7EB"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <!-- 2. Messages App -->
                <LinearLayout
                    android:id="@+id/btn_launch_messages"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:background="@drawable/bg_power_circle"
                        android:text="💬"
                        android:textSize="28sp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Messages"
                        android:textColor="#E5E7EB"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <!-- 3. Chrome App -->
                <LinearLayout
                    android:id="@+id/btn_launch_chrome"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:background="@drawable/bg_power_circle"
                        android:text="🌐"
                        android:textSize="28sp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chrome"
                        android:textColor="#E5E7EB"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 2: Camera, ChatGPT / Gemini, SchoolMini -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- 4. Camera App -->
                <LinearLayout
                    android:id="@+id/btn_launch_camera"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:background="@drawable/bg_power_circle"
                        android:text="📷"
                        android:textSize="28sp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Camera"
                        android:textColor="#E5E7EB"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <!-- 5. AI (ChatGPT or Gemini) -->
                <LinearLayout
                    android:id="@+id/btn_launch_ai"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:background="@drawable/bg_power_circle"
                        android:text="✨"
                        android:textSize="28sp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gemini/AI"
                        android:textColor="#E5E7EB"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <!-- 6. SchoolMini Manager (With Official Logo) -->
                <LinearLayout
                    android:id="@+id/btn_launch_schoolmini"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <FrameLayout
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:background="@drawable/bg_power_circle">

                        <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_schoolmini_logo"
                            android:contentDescription="SchoolMini Logo"
                            android:scaleType="fitCenter" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SchoolMini"
                        android:textColor="#E5E7EB"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Bottom School Hours Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="16dp">

            <TextView
                android:id="@+id/tv_duty_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="School ends in 3 h 15 min (09:00 - 15:00)"
                android:textColor="#9CA3AF"
                android:textSize="13sp"
                android:gravity="center" />

            <Button
                android:id="@+id/btn_duty_turn_off_bottom"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_card_dark"
                android:text="Turn Off Duty Mode"
                android:textColor="#E2E8F0"
                android:textSize="13sp"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </LinearLayout>


    <!-- ======================================================== -->
    <!-- 3. DASHBOARD SCREEN (White Porcelain + #53A7E1 Brand)    -->
    <!-- ======================================================== -->
    <LinearLayout
        android:id="@+id/layout_dashboard_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F8FAFC"
        android:visibility="visible">

        <!-- Top Navigation Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:paddingHorizontal="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="16dp"
            android:elevation="1dp">

            <!-- Logo + Title -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_logo_container"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_schoolmini_logo"
                    android:contentDescription="SchoolMini Logo"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="School Mini"
                    android:textColor="#53A7E1"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02" />

                <TextView
                    android:id="@+id/tv_dash_welcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="student@school.edu • Active"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <!-- Cloud: Live Badge -->
            <TextView
                android:id="@+id/tv_render_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_live"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="● Cloud: Live"
                android:textColor="#059669"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <!-- Clean Modern Logout Button -->
            <Button
                android:id="@+id/btn_dash_logout"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_button_logout"
                android:text="Logout"
                android:textColor="#DC2626"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="12dp" />
        </LinearLayout>

        <!-- Dashboard Content Scroll -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="18dp">

                <!-- 1. DUTY MODE ACTIVATION CARD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_white"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_marginBottom="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DUTY MODE (SCHOOL FIREWALL)"
                            android:textColor="#53A7E1"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:id="@+id/tv_duty_mode_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:background="#F1F5F9"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="9:00 AM – 3:00 PM"
                            android:textColor="#64748B"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enforces strict distraction-free school mode. Restricts all apps on this device except Calling, Messages, Chrome, Camera, Gemini/AI, and SchoolMini."
                        android:textColor="#334155"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="18dp" />

                    <!-- Big Scan QR Button in #53A7E1 -->
                    <Button
                        android:id="@+id/btn_scan_duty_qr"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_button_brand"
                        android:text="📷  SCAN QR CODE TO ARM DUTY MODE"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Quick Options -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="12dp">

                        <Button
                            android:id="@+id/btn_enter_code_dialog"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:background="@android:color/transparent"
                            android:text="Enter QR Code Manually"
                            android:textColor="#53A7E1"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" • "
                            android:textColor="#CBD5E1" />

                        <Button
                            android:id="@+id/btn_quick_toggle_duty"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:background="@android:color/transparent"
                            android:text="⚡ Quick Arm"
                            android:textColor="#059669"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 2. PERMITTED TOOLS CARD (Executive App Overview) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_white"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PERMITTED TOOLS IN DUTY MODE"
                        android:textColor="#53A7E1"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Only these 6 essential apps remain accessible during school hours. All games, social media, and distracting apps are automatically intercepted."
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="14dp" />

                    <!-- Allowed Apps Badges Grid -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:background="#F1F5F9"
                            android:gravity="center"
                            android:text="📞 Phone"
                            android:textColor="#0F172A"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:background="#F1F5F9"
                            android:gravity="center"
                            android:text="💬 Messages"
                            android:textColor="#0F172A"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginStart="3dp"
                            android:layout_marginEnd="3dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:background="#F1F5F9"
                            android:gravity="center"
                            android:text="🌐 Chrome"
                            android:textColor="#0F172A"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:background="#F1F5F9"
                            android:gravity="center"
                            android:text="📷 Camera"
                            android:textColor="#0F172A"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:background="#F1F5F9"
                            android:gravity="center"
                            android:text="✨ Gemini / AI"
                            android:textColor="#0F172A"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginStart="3dp"
                            android:layout_marginEnd="3dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:background="#F1F5F9"
                            android:gravity="center"
                            android:text="🛡️ SchoolMini"
                            android:textColor="#53A7E1"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 3. MASTER FIREWALL & PERMISSIONS CARD -->
                <LinearLayout
                    android:id="@+id/card_master_shield"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_white"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_marginBottom="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MASTER FIREWALL"
                                android:textColor="#53A7E1"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.05" />

                            <TextView
                                android:id="@+id/tv_shield_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ACTIVE &amp; GUARDING"
                                android:textColor="#059669"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <Switch
                            android:id="@+id/sw_master_shield"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:checked="true" />
                    </RelativeLayout>

                    <!-- Armed Banner -->
                    <LinearLayout
                        android:id="@+id/layout_permissions_armed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_live"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp"
                        android:layout_marginTop="14dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✓ "
                            android:textColor="#059669"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="All system permissions active. Zero-distraction firewall armed."
                            android:textColor="#065F46"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Setup Needed Actions -->
                    <LinearLayout
                        android:id="@+id/layout_permissions_setup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="10dp">

                            <TextView
                                android:id="@+id/pill_overlay"
                                android:layout_width="0dp"
                                android:layout_height="32dp"
                                android:layout_weight="1"
                                android:background="#FEF2F2"
                                android:textColor="#DC2626"
                                android:text="Overlay: OFF"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:layout_marginEnd="6dp" />

                            <TextView
                                android:id="@+id/pill_usage"
                                android:layout_width="0dp"
                                android:layout_height="32dp"
                                android:layout_weight="1"
                                android:background="#FEF2F2"
                                android:textColor="#DC2626"
                                android:text="Usage Engine: OFF"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:layout_marginStart="6dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btn_grant_overlay"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_button_brand"
                                android:text="GRANT OVERLAY"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="6dp" />

                            <Button
                                android:id="@+id/btn_grant_usage"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_button_brand"
                                android:text="GRANT USAGE"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:layout_marginStart="6dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Footer branding -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SchoolMini Focus OS • Protected by Cloud Firewall"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="24dp" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</FrameLayout>
